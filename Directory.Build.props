<Project>
    <PropertyGroup>
        <!-- Define the symbol here to apply it to all projects in the solution -->
        <REFERENCE_OROptimizer_Shared_PROJECT>false</REFERENCE_OROptimizer_Shared_PROJECT>
        <REFERENCE_OROptimizer_Shared_Log4Net_PROJECT>false</REFERENCE_OROptimizer_Shared_Log4Net_PROJECT>
        <REFERENCE_FileInclude_PROJECT>false</REFERENCE_FileInclude_PROJECT>
        <REFERENCE_ClassVisualizer_PROJECT>false</REFERENCE_ClassVisualizer_PROJECT>
        <REFERENCE_TestsSharedLibrary_PROJECT>false</REFERENCE_TestsSharedLibrary_PROJECT>
        
        <REFERENCE_IoC_Configuration_PROJECT>false</REFERENCE_IoC_Configuration_PROJECT>
        <REFERENCE_IoC_Configuration_Autofac_PROJECT>false</REFERENCE_IoC_Configuration_Autofac_PROJECT>
        <REFERENCE_IoC_Configuration_Ninject_PROJECT>false</REFERENCE_IoC_Configuration_Ninject_PROJECT>
        <REFERENCE_IoC_Configuration_Extensions_PROJECT>false</REFERENCE_IoC_Configuration_Extensions_PROJECT>
        <REFERENCE_IoC_Configuration_AspNet_PROJECT>false</REFERENCE_IoC_Configuration_AspNet_PROJECT>
        <REFERENCE_IoC_Configuration_Maui_PROJECT>false</REFERENCE_IoC_Configuration_Maui_PROJECT>              
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_OROptimizer_Shared_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_OROptimizer_Shared_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_OROptimizer_Shared_Log4Net_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_OROptimizer_Shared_Log4Net_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_FileInclude_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_FileInclude_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_ClassVisualizer_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_ClassVisualizer_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_TestsSharedLibrary_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_TestsSharedLibrary_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_IoC_Configuration_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_IoC_Configuration_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_IoC_Configuration_Autofac_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_IoC_Configuration_Autofac_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_IoC_Configuration_Ninject_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_IoC_Configuration_Ninject_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_IoC_Configuration_Extensions_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_IoC_Configuration_Extensions_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_IoC_Configuration_AspNet_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_IoC_Configuration_AspNet_PROJECT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(REFERENCE_IoC_Configuration_Maui_PROJECT)' == 'true'">
        <DefineConstants>$(DefineConstants);REFERENCE_IoC_Configuration_Maui_PROJECT</DefineConstants>
    </PropertyGroup>
    
</Project>