<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<Content Remove="C:\Users\artak\.nuget\packages\oroptimizer.shared.log4net\1.0.0\contentFiles\any\net6.0\README.md" />
		<Content Remove="C:\Users\artak\.nuget\packages\oroptimizer.shared\2.2.0\contentFiles\any\netstandard2.0\README.md" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="log4net" Version="3.2.0" />
	</ItemGroup>
	<ItemGroup>
		<None Update="IoC.Configuration.DocumentationGenerator.log4net.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>	

	<!--OROptimizer.Shared-->
	<ItemGroup Condition="'$(Configuration)'=='Release' Or !$(DefineConstants.Contains('REFERENCE_OROptimizer_Shared_PROJECT'))">
		<PackageReference Include="OROptimizer.Shared" Version="2.7.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug' And $(DefineConstants.Contains('REFERENCE_OROptimizer_Shared_PROJECT'))">
		<ProjectReference Include="..\..\OROptimizer.Shared\OROptimizer.Shared\OROptimizer.Shared.csproj" />
	</ItemGroup>

	<!--OROptimizer.Shared.Log4Net-->
	<ItemGroup Condition="'$(Configuration)'=='Release' Or !$(DefineConstants.Contains('REFERENCE_OROptimizer_Shared_Log4Net_PROJECT'))">
		<PackageReference Include="OROptimizer.Shared.Log4Net" Version="1.1.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug' And $(DefineConstants.Contains('REFERENCE_OROptimizer_Shared_Log4Net_PROJECT'))">
		<ProjectReference Include="..\..\OROptimizer.Shared.Log4Net\OROptimizer.Shared.Log4Net\OROptimizer.Shared.Log4Net.csproj" />
	</ItemGroup>

	<!--FileInclude-->
	<ItemGroup Condition="'$(Configuration)'=='Release' Or !$(DefineConstants.Contains('REFERENCE_FileInclude_PROJECT'))">
		<PackageReference Include="FileInclude" Version="1.3.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug' And $(DefineConstants.Contains('REFERENCE_FileInclude_PROJECT'))">
		<ProjectReference Include="..\..\FileInclude\FileInclude\FileInclude.csproj" />
	</ItemGroup>
</Project>
