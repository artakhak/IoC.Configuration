<Page
    x:Class="WinUI3Demo.RandomNumber.RandomNumberPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Demo">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="Random Number Generator" Style="{StaticResource HeaderTextBlockStyle}"/>
        <TextBlock Text="{x:Bind ViewModel.RandomNumber, Mode=OneWay}" 
                   FontSize="48" HorizontalAlignment="Center" FontWeight="Bold"/>
        <Button Content="Generate New Number" 
                Click="Generate_Click"
                HorizontalAlignment="Center"/>
    </StackPanel>
</Page>