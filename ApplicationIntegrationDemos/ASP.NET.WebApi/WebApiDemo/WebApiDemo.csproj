<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a80f898f-73c8-4e74-b8f7-4febdca15ad6</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.0.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\OROptimizer.Shared\OROptimizer.Shared\OROptimizer.Shared.csproj" />
    <ProjectReference Include="..\..\..\IoC.Configuration.AspNetHostConfiguration\IoC.Configuration.AspNetHostConfiguration.csproj" />
    <ProjectReference Include="..\..\..\IoC.Configuration\IoC.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="IoCConfiguration.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!--<None Include="IoCConfigurationFiles\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>-->
  </ItemGroup>

  <!--<Target Name="CopyIoCConfigurationFiles" AfterTargets="Build">
    <Message Text="Copying IoCConfigurationFiles to output directory..." Importance="high" />
    --><!-- 
      /E : Copies directories and subdirectories, including empty ones.
