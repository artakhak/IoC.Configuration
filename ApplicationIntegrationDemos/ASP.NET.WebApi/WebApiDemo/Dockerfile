#See https://aka.ms/customizecontainer to learn how to customize your debug container and how Visual Studio uses this Dockerfile to build your images for faster debugging.

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER app
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Debug

WORKDIR /src

COPY ["ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo/WebApiDemo.csproj", "ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo/"]
COPY ["ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.DynamicallyLoadedControllers/WebApiDemo.DynamicallyLoadedControllers.csproj", "ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.DynamicallyLoadedControllers/"]
COPY ["ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.Extension/WebApiDemo.Extension.csproj", "ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.Extension/"]

RUN dotnet restore "./ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo/WebApiDemo.csproj"
RUN dotnet restore "./ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.DynamicallyLoadedControllers/WebApiDemo.DynamicallyLoadedControllers.csproj"
RUN dotnet restore "./ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.Extension/WebApiDemo.Extension.csproj"

COPY . .

## 1. Create the IoCConfigurationFiles structure in /app/build
#RUN mkdir -p /app/build/IoCConfigurationFiles/ContainerImplementations \
#             /app/build/IoCConfigurationFiles/ThirdPartyLibs \
#             /app/build/IoCConfigurationFiles/PluginDlls/WebApiDemoExtension \
#             /app/build/DynamicallyLoadedDlls 

# 2. Copy existing IoCConfigurationFiles content
# Assuming the local 'IoCConfigurationFiles' folder is in the context root
# remove this
#RUN cp -r IoCConfigurationFiles/ContainerImplementations/. /app/build/IoCConfigurationFiles/ContainerImplementations/ && \
#    cp -r IoCConfigurationFiles/ThirdPartyLibs/. /app/build/IoCConfigurationFiles/ThirdPartyLibs/ 
 
# 3. Build WebApiDemo
WORKDIR "/src/ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo"
RUN dotnet build "./WebApiDemo.csproj" -c $BUILD_CONFIGURATION -o /app/build

# 4. Build DynamicallyLoadedControllers and copy to /app/build/IoCConfigurationFiles/DynamicallyLoadedDlls
WORKDIR "/src/ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.DynamicallyLoadedControllers"
RUN dotnet build "./WebApiDemo.DynamicallyLoadedControllers.csproj" -c $BUILD_CONFIGURATION -o /app/build/IoCConfigurationFiles/DynamicallyLoadedDlls

# 5. Build WebApiDemo.Extension and copy to plugin folder
WORKDIR "/src/ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo.Extension"
RUN dotnet build "./WebApiDemo.Extension.csproj" -c $BUILD_CONFIGURATION -o /app/build/IoCConfigurationFiles/PluginDlls/WebApiDemoExtension

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
WORKDIR "/src/ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo"
RUN dotnet publish "./WebApiDemo.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Copy the libraries directly into the final image's app directory
COPY ["ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo/IoCConfigurationFiles/ContainerImplementations/Autofac/", "IoCConfigurationFiles/ContainerImplementations/Autofac/"]
COPY ["ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo/IoCConfigurationFiles/ContainerImplementations/Ninject/", "IoCConfigurationFiles/ContainerImplementations/Ninject/"]
COPY ["ApplicationIntegrationDemos/ASP.NET.WebApi/WebApiDemo/IoCConfigurationFiles/ThirdPartyLibs/", "IoCConfigurationFiles/ThirdPartyLibs/"]

# Also ensure the dynamically built plugins from the build stage are moved over
# COPY --from=build /app/build/IoCConfigurationFiles/ /app/IoCConfigurationFiles/
COPY --from=build /app/build/IoCConfigurationFiles/DynamicallyLoadedDlls/ /app/IoCConfigurationFiles/DynamicallyLoadedDlls/
COPY --from=build /app/build/IoCConfigurationFiles/PluginDlls/WebApiDemoExtension/ /app/IoCConfigurationFiles/PluginDlls/WebApiDemoExtension/

# Create the 'IoCConfigurationFiles/AutogeneratedDlls/IoCConfiguration' folder in /app/build

# Switch to root to create directories and set permissions
USER root
RUN mkdir -p /app/IoCConfigurationFiles/AutogeneratedDlls/IoCConfiguration && \
    chown -R app:app /app/IoCConfigurationFiles

# Switch back to the non-privileged user
USER app
    
ENTRYPOINT ["dotnet", "WebApiDemo.dll"]